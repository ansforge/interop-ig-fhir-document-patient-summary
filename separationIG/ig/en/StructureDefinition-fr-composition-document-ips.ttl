         fhir:ElementDefinition.constraint.human [ fhir:value "Au plus un participant de rôle Médecin traitant (extension[type]=INF, extension[function]=PCP)." ] ;
         fhir:ElementDefinition.constraint.expression [ fhir:value "extension('participant').where(extension('type').value.coding.code = 'INF' and extension('function').value.coding.code = 'PCP').count() <= 1" ] ;
