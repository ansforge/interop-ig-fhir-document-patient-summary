         fhir:ElementDefinition.constraint.expression [ fhir:value "extension('participant').where(extension('type').value.coding.code = 'PRF' and extension('function').value.coding.code = 'CORRE').count() <= 1" ] ;
         fhir:ElementDefinition.constraint.source [
           fhir:value "https://interop.esante.gouv.fr/ig/fhir/fr-patient-summary/StructureDefinition/fr-composition-document-ips|0.1.0" ;
